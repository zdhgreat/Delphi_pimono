        <DCCReference Include="Utils\Utils.JsonHelper.pas"/>
        <DCCReference Include="Utils\Utils.Localization.pas"/>
        <DCCReference Include="Utils\Utils.TokenEstimator.pas"/>
        <DCCReference Include="Core\Core.ToolResultSlim.pas"/>
